                "maps": [
                  "nation_of_fools"
                ]
              }
            },
            {
              "title": "Forest of Doom",
              "content": {
                "type": "map",
                "maps": [
                  "forest_of_doom"
                ]
              }
            },
            {
              "title": "13th Street",
              "content": {
                "type": "map",
                "maps": [
                  "13th_street"
                ]
              }
            },
            {
              "title": "Forgotten City",
              "content": {
                "type": "map",
                "maps": [
                  "forgotten_city"
                ]
              }
            },
            {
              "title": "Burnt Paradise",
              "content": {
                "type": "map",
                "maps": [
                  "burnt_paradise"
                ]
              }
            },
            {
              "title": "Dark Academy",
              "content": {
                "type": "map",
                "maps": [
                  "dark_academy"
                ]
              }
            },
            {
              "title": "Nest of Evil",
              "content": {
                "type": "map",
                "maps": [
                  "nest_of_evil"
                ]
