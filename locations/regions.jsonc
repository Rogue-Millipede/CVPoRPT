[
	{
		"name": "Entrance Regions",
		"children": [
			{
				"name": "Wind's Room", // Used for quests/shops
				"access_rules": [
					"@Entrance Regions/Hub",
				]
			},
			{
				"name": "Hub", // The entire starting area up through the hub
				"access_rules": [
					"", // starting region
					"@Entrance Regions/Wind's Room",
					"@Entrance Regions/Hub Painting Room, $is_smol",
					"@Entrance Regions/Underground Passage, $small_uppies",
					"@Entrance Regions/Upper Area",
					"@Entrance Regions/Behemoth Area"
				]
			},
			{
				"name": "Behemoth Area", // The area past the first jump check, Behemoth's boss room
				"access_rules": [
					"@Entrance Regions/Hub, $small_uppies",
					"@Entrance Regions/Post Behemoth, $boss_door_open|Colosseum Key"
				]
			},
			{
				"name": "Post Behemoth", // The area right of behemoth, for boss keys
				"access_rules": [
					"@Entrance Regions/Behemoth Area, $boss_door_open|Colosseum Key",
					"@Buried Chamber Regions/Main",
					"@Great Stairway Regions/Lower, $strongies"
				]
			},
			{
				"name": "Underground Passage", // The tunnel leading to the Nest of Evil portrait
				"access_rules": [
					"@Entrance Regions/Hub, $has_enough_portraits_for_nest"
				]
			},
			{
				"name": "Hub Painting Room", // The City of Haze portrait
				"access_rules": [
					"@Entrance Regions/Hub, $is_smol",
					"@Entrance Regions/Hub, $has|puppet_master"
				]
			},
			{
				"name": "Upper Area", // The upper route from the statue room
				"access_rules": [
					"@Entrance Regions/Hub, $has|acrobat_cube, $has|stone_of_flight, $has_call_cube",
					"@Entrance Regions/Hub, $big_uppies",
					"@Great Stairway Regions/Entrance Connector"
				]
			}
		]
	},
	{
		"name": "Buried Chamber Regions",
		"children": [
			{
				"name": "Main", // The ENTIRE buried Chamber, since it all falls under the same logic
				"access_rules": [
					"@Entrance Regions/Post Behemoth",
					"@Great Stairway Regions/Lower"
				]
			}
		]
	},
	{
		"name": "Great Stairway Regions",
		"children": [
			{
				"name": "Lower", // Ground level up to Keremet and the check afterwards
				"access_rules": [
					"@Entrance Regions/Post Behemoth, $strongies",
					"@Buried Chamber Regions/Main",
					"@Great Stairway Regions/Post Keremet, $boss_door_open|Cavern Key",
					"@Great Stairway Regions/Staircases"
				]
			},
			{
				"name": "Staircases", // The big stairs rooms and surrounding areas
				"access_rules": [
					"@Great Stairway Regions/Lower, $has|stone_of_flight",
					"@Great Stairway Regions/Lower, $big_uppies",
					"@Great Stairway Regions/Post Keremet, $has|stone_of_flight",
					"@Great Stairway Regions/Post Keremet, $big_uppies",
					"@Great Stairway Regions/Underground Painting",
					"@Great Stairway Regions/Entrance Connector",
					"@Great Stairway Regions/Upper"
				]
			},
			{
				"name": "Post Keremet", // The item after Keremt, for boss keys
				"access_rules": [
					"@Great Stairway Regions/Lower, $boss_door_open|Cavern Key",
					"@Great Stairway Regions/Staircases"
				]
			},
			{
				"name": "Entrance Connector", // The part that connects to the entrance and the wall switch.
				// There's an awkward jump to the upper level that can't be made with acrobat.
				"access_rules": [
					"@Entrance Regions/Upper Area",
					"@Great Stairway Regions/Upper"
				]
			},
			{
				"name": "Upper", // The towers to the left of the staircase rooms
				"access_rules": [
					"@Great Stairway Regions/Staircases, $small_uppies",
					"@Great Stairway Regions/Staircases, $has|puppet_master",
					"@Great Stairway Regions/Entrance Connector, $has|acrobat_cube, $has|puppet_master, $has_call_cube",
					"@Great Stairway Regions/Entrance Connector, $medium_uppies",
					"@Great Stairway Regions/Entrance Connector, $has|acrobat_cube, $has|speed_up, $has_call_cube",
					"@Great Stairway Regions/Central Painting Area",
					"@Tower of Death Regions/Belt Area, $can_cast_spell, $has|owl_morph",
					"@Tower of Death Regions/Belt Area, $can_cast_spell, $has|toad_morph"
				]
			},
			{
				"name": "Central Painting Area", // The painting but also the secret room with the nun robes
				"access_rules": [
					"@Great Stairway Regions/Upper, $small_uppies"
				]
			},
			{
				"name": "Underground Painting", // The sandy graves portrait room
				"access_rules": [
					"@Great Stairway Regions/Staircases"
				]
			}
		]
	},
